# Copy to local.properties; the local file is ignored by Git.
# macOS example (replace with your own absolute SDK directory):
sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

# Jam defaults to Daylight's Cloudflare service; optional override:
LISTEN_TOGETHER_SERVER=https://jam.sh1vvy.com

# Optional integrations owned/configured by you. Leave blank to omit.
LASTFM_API_KEY=
LASTFM_SECRET=
DISCORD_APPLICATION_ID=
