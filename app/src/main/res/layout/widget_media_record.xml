<?xml version="1.0" encoding="utf-8"?>
<!-- Framework views only: the launcher owns the clock and all transport targets stay 48dp. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_record_surface"
    android:clipToOutline="true"
    android:theme="@android:style/Theme.DeviceDefault.DayNight">
    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_record_disc" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/widget_record_wave"
                android:visibility="gone"
                android:layout_width="26dp"
                android:layout_height="12dp"
                android:layout_marginBottom="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_record_equalizer" />
            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:includeFontPadding="false"
                android:gravity="center"
                android:text="@string/widget_choose_music"
                android:textColor="@color/widget_material_secondary"
                android:textSize="13sp"
                android:ellipsize="end"
                android:maxLines="1" />
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:gravity="center"
                android:text="@string/widget_nothing_played"
                android:textColor="@color/widget_material_on_surface"
                android:textSize="14sp"
                android:ellipsize="end"
                android:maxLines="1" />
            <ProgressBar
                android:id="@+id/widget_record_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="56dp"
                android:layout_height="3dp"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="7dp"
                android:importantForAccessibility="no"
                android:indeterminate="false"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/widget_record_progress"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/widget_record_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">
                <Chronometer
                    android:id="@+id/widget_record_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_material_on_surface"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/widget_record_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_material_secondary"
                    android:textSize="12sp"
                    android:maxLines="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_previous"
                    android:visibility="gone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_record_transport"
                    android:contentDescription="@string/widget_previous"
                    android:padding="13dp"
                    android:src="@drawable/ic_widget_previous"
                    android:tint="@color/widget_material_secondary" />
                <ImageView
                    android:id="@+id/widget_toggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_record_transport"
                    android:contentDescription="@string/widget_play"
                    android:padding="13dp"
                    android:src="@drawable/ic_widget_play"
                    android:tint="@color/widget_material_on_surface" />
                <ImageView
                    android:id="@+id/widget_next"
                    android:visibility="gone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_record_transport"
                    android:contentDescription="@string/widget_next"
                    android:padding="13dp"
                    android:src="@drawable/ic_widget_next"
                    android:tint="@color/widget_material_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
